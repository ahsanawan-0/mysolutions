# Copy to .env (never commit .env)

# local | staging | production
APP_ENV=local

# Absolute site origin, no trailing slash. Production: https://mysolutionz.co.uk
SITE_URL=http://localhost:8000

# true = load assets from the Vite dev server (npm run dev); false = use public/assets/build/manifest.json
VITE_DEV=true

# Mail (P23). log = write messages to storage/mail/ instead of sending
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=info@mysolutionz.co.uk
MAIL_FROM_NAME="My Solutionz"
MAIL_TO_ADDRESS=info@mysolutionz.co.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Optional Cloudflare Turnstile on the contact form (P23). Off by default; no reCAPTCHA.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (P28, app/config/cookies.php): none (default) | plausible | ga4. Nothing loads before consent.
# ANALYTICS_ID: GA4 measurement ID (G-XXXXXXXXXX) or the Plausible site domain (mysolutionz.co.uk).
# ANALYTICS_EXEMPT=true (Plausible only) relies on the DUAA 2025 statistics exemption: on unless the visitor opts out.
ANALYTICS_PROVIDER=none
ANALYTICS_ID=
ANALYTICS_EXEMPT=false
PLAUSIBLE_SRC=https://plausible.io/js/script.js
