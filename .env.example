# Copy to .env (never commit .env)

# local | staging | production
APP_ENV=local

# Absolute site origin, no trailing slash. Production: https://mysolutionz.co.uk
SITE_URL=http://localhost:8000

# true = load assets from the Vite dev server (npm run dev); false = use public/assets/build/manifest.json
VITE_DEV=true

# Mail (P23). log = write messages to storage/mail/ instead of sending
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=info@mysolutionz.co.uk
MAIL_FROM_NAME="My Solutionz"
MAIL_TO_ADDRESS=info@mysolutionz.co.uk
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Analytics (P28): empty = none; ga4 | plausible | fathom
ANALYTICS_PROVIDER=
ANALYTICS_ID=
