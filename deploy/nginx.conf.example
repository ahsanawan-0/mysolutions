# My Solutionz: Nginx + PHP-FPM equivalent of public/.htaccess
# Document root = <project>/public. Adjust paths, the PHP-FPM socket and certificate locations.

# http → https (any host), one hop
server {
    listen 80;
    listen [::]:80;
    server_name mysolutionz.co.uk www.mysolutionz.co.uk;
    return 301 https://mysolutionz.co.uk$request_uri;
}

# www → non-www, one hop
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.mysolutionz.co.uk;
    ssl_certificate     /etc/letsencrypt/live/mysolutionz.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mysolutionz.co.uk/privkey.pem;
    return 301 https://mysolutionz.co.uk$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mysolutionz.co.uk;

    root /var/www/mysolutionz/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/mysolutionz.co.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mysolutionz.co.uk/privkey.pem;

    # Security headers (nonce-based CSP is added in P34)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    server_tokens off;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf;
    # brotli on; brotli_types ...;   # if ngx_brotli is installed

    # Block dotfiles and source maps
    location ~ /\. { deny all; }
    location ~ \.map$ { deny all; }

    # Hashed build assets and fonts: immutable
    location ~* ^/assets/(build|fonts)/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Images
    location ~* \.(avif|webp|jpe?g|png|gif|svg|ico)$ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # Static machine files / html: short cache
    location ~* \.(xml|txt|webmanifest|html?)$ {
        add_header Cache-Control "public, max-age=600, must-revalidate";
        try_files $uri /index.php$is_args$args;
    }

    # Front controller
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
    }
}
