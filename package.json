{
  "name": "mysolutionz-website",
  "private": true,
  "version": "0.1.0",
  "description": "My Solutionz website front-end build (Vite + GSAP + Lenis)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run icons && npm run art",
