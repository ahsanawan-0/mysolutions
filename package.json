    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
