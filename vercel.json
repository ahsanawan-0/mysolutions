{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{node_modules/**,assets-src/**,inspirations/**,logos/**,design/**,docs/**,deploy/**,scripts/**,bin/**,storage/**,vercel.json,.vercelignore}"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index(\\.php)?", "status": 301, "headers": { "Location": "/" } },
    { "src": "/\\.htaccess", "status": 404 },
    { "src": "/assets/(build|fonts)/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
